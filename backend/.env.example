# Django Settings
SECRET_KEY=your-django-secret-key
DEBUG=True
BASE_URL=http://localhost:8000

# Database Settings (Uncomment and set if using MySQL)
# If MYSQLDATABASE is not set, SQLite (db.sqlite3) will be used automatically
# MYSQLDATABASE=eventbookingdb
# MYSQLUSER=root
# MYSQLPASSWORD=your_password
# MYSQLHOST=127.0.0.1
# MYSQLPORT=3306

# Email Settings
# EMAIL_HOST_PASSWORD=your_gmail_app_password

# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Deployment
# RAILWAY_PUBLIC_DOMAIN=your_railway_domain
